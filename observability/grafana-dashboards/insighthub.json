{
  "uid": "insighthub-day4",
  "title": "InsightHub - RED / USE / AIOps",
  "tags": [
    "insighthub",
    "day4"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Datasource",
        "current": {}
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(insighthub_http_requests_total, namespace)",
        "refresh": 2,
        "includeAll": false,
        "label": "Namespace"
      },
      {
        "name": "price_input_per_mtok",
        "type": "textbox",
        "label": "LLM input USD/1M tok",
        "query": "0",
        "current": {
          "value": "0",
          "text": "0"
        }
      },
      {
        "name": "price_output_per_mtok",
        "type": "textbox",
        "label": "LLM output USD/1M tok",
        "query": "0",
        "current": {
          "value": "0",
          "text": "0"
        }
      },
      {
        "name": "price_embedding_per_mtok",
        "type": "textbox",
        "label": "Embedding USD/1M tok",
        "query": "0",
        "current": {
          "value": "0",
          "text": "0"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(kube_deployment_status_observed_generation{namespace=~\"$namespace\"}[2m]) > 0",
        "titleFormat": "rollout {{deployment}}",
        "textFormat": "deployment generation changed",
        "step": "60s"
      },
      {
        "name": "Alerts",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "ALERTS{alertstate=\"firing\",alertname=~\"InsightHub.*\",namespace=~\"$namespace\"}",
        "titleFormat": "{{alertname}}",
        "step": "60s"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate - requests/s by endpoint (RED)",
      "description": "RED Rate from the api middleware counter.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (endpoint) (rate(insighthub_http_requests_total{job=\"insighthub-api\",namespace=~\"$namespace\",endpoint!=\"/metrics\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors - 5xx ratio + anomaly band (RED)",
      "description": "Recording rule + the same band the ErrorRateAnomaly alert uses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:http_errors:ratio_rate5m{namespace=~\"$namespace\"}",
          "legendFormat": "5xx ratio"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:http_errors:ratio_rate5m:avg_1h{namespace=~\"$namespace\"} + clamp_min(3 * insighthub:http_errors:ratio_rate5m:stddev_1h{namespace=~\"$namespace\"}, 0.05)",
          "legendFormat": "alert band"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration - RAG p95 latency (RED)",
      "description": "End-to-end /chat retrieval + generation.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:rag_latency_seconds:p95_5m{namespace=~\"$namespace\"}",
          "legendFormat": "RAG p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(insighthub_rag_query_latency_seconds_bucket{job=\"insighthub-api\",namespace=~\"$namespace\"}[5m])))",
          "legendFormat": "RAG p50"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "LLM latency p95 + anomaly band",
      "description": "Same band as InsightHubLLMLatencyAnomaly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:llm_latency_seconds:p95_5m{namespace=~\"$namespace\"}",
          "legendFormat": "LLM p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:llm_latency_seconds:p95_5m:avg_1h{namespace=~\"$namespace\"} + clamp_min(3 * insighthub:llm_latency_seconds:p95_5m:stddev_1h{namespace=~\"$namespace\"}, 0.5)",
          "legendFormat": "alert band"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth - pending documents + arq:queue",
      "description": "Accepted-but-unprocessed work. redis_key_size disappears when the queue key is empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:queue_backlog{namespace=~\"$namespace\"}",
          "legendFormat": "pending documents (DB)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(redis_key_size{namespace=~\"$namespace\",key=\"arq:queue\"})",
          "legendFormat": "arq:queue jobs (redis)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "insighthub:queue_backlog:avg_1h{namespace=~\"$namespace\"} + clamp_min(3 * insighthub:queue_backlog:stddev_1h{namespace=~\"$namespace\"}, 5)",
          "legendFormat": "alert band"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker throughput by outcome",
      "description": "ingestion-worker /metrics :9101.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (rate(insighthub_worker_jobs_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "{{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(insighthub_ingestion_errors_total{job=\"insighthub-ingestion-worker\",namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "ingestion errors"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Token usage (provider + estimated)",
      "description": "Tokens/s. Fixture mode has no provider tokens, only word-based embedding estimates (labelled ESTIMATE).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, direction) (rate(insighthub_llm_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "llm {{provider}} {{direction}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, input_type) (rate(insighthub_embedding_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "embedding {{provider}} {{input_type}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, input_type) (rate(insighthub_embedding_estimated_tokens_total{namespace=~\"$namespace\"}[5m]))",
          "legendFormat": "embedding ESTIMATE {{provider}} {{input_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Estimated model cost (USD/hour)",
      "description": "Token rate x price per 1M tokens (dashboard variables). Estimate only; the provider bill is authoritative.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "3600 * ( sum(rate(insighthub_llm_tokens_total{namespace=~\"$namespace\",direction=\"input\"}[5m]) or vector(0)) * $price_input_per_mtok + sum(rate(insighthub_llm_tokens_total{namespace=~\"$namespace\",direction=\"output\"}[5m]) or vector(0)) * $price_output_per_mtok + sum(rate(insighthub_embedding_tokens_total{namespace=~\"$namespace\"}[5m]) or vector(0)) * $price_embedding_per_mtok + sum(rate(insighthub_embedding_estimated_tokens_total{namespace=~\"$namespace\"}[5m]) or vector(0)) * $price_embedding_per_mtok ) / 1e6",
          "legendFormat": "USD/hour (estimate)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pod CPU (cores)",
      "description": "USE: cAdvisor via kubelet.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\",container!=\"\",container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pod memory working set",
      "description": "USE: compare with the 768Mi api/worker limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=~\"$namespace\",container!=\"\",container!=\"POD\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Deployments - generation / available replicas",
      "description": "Generation steps = rollouts (also drawn as dashboard annotations).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_observed_generation{namespace=~\"$namespace\"}",
          "legendFormat": "gen {{deployment}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "kube_deployment_status_replicas_available{namespace=~\"$namespace\"}",
          "legendFormat": "available {{deployment}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Scrape health - 5 components",
      "description": "1 = UP. api, ingestion-worker, redis-exporter, postgres-exporter + blackbox probe of web.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{namespace=~\"$namespace\"}",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "probe_success{job=~\".*-web\"}",
          "legendFormat": "web probe"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Documents by status",
      "description": "Refreshed on each api scrape.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (status) (insighthub_documents_total{job=\"insighthub-api\",namespace=~\"$namespace\"})",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}