# DO2603 starter 0.2.3. Copy to .env. Never commit actual keys.
# No paid services or model downloads in the default profile.
RAG_MODE=fixture
LLM_PROVIDER=fixture
EMBEDDING_PROVIDER=fixture
API_PORT=8000
WEB_PORT=3000
LLM_MAX_TOKENS=1024
EMBEDDING_DIM=1024
EMBEDDING_REVISION=1
PROVIDER_TIMEOUT_SECONDS=60
# REAL mode: set RAG_MODE=real and both providers explicitly.
# LLM: gemini | anthropic | openai | ollama
# Embedding: gemini | voyage | openai | ollama
# Never reuse a populated fixture index for real embeddings. See GETTING_STARTED.
LLM_MODEL=
EMBEDDING_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
OPENAI_API_KEY=
# Explicit endpoint required, e.g. https://api.openai.com/v1 or a vetted gateway.
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-3.5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# Chat model chosen after measuring available RAM/latency and quality.
# mxbai-embed-large emits 1024 dimensions; no padding/truncation.

# Day 1 async ingestion. api and ingestion-worker MUST share both values, or
# uploads return 202 and nothing is ever processed.
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/var/lib/insighthub/uploads
