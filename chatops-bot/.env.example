# Copy thành chatops-bot/.env (đã gitignore) rồi: set -a; source chatops-bot/.env; set +a
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_BOT_USER_ID=
# Slack user ID được phép yêu cầu/duyệt scale (CSV). Người khác chỉ dùng được intent đọc.
CHATOPS_OPERATOR_IDS=
CHATOPS_NAMESPACE=insighthub-local
CHATOPS_TIMEZONE=Asia/Ho_Chi_Minh
# Identity đọc cho Kubernetes MCP và identity ghi riêng cho scale (tạo bằng k8s/make-kubeconfig.sh)
CHATOPS_READONLY_KUBECONFIG=/Users/zotabox/.kube/chatops-readonly.kubeconfig
CHATOPS_SCALER_KUBECONFIG=/Users/zotabox/.kube/chatops-scaler.kubeconfig
PROMETHEUS_URL=http://localhost:9090
# Tuỳ chọn (Day 6): LLM tool loop cho câu hỏi ngoài 3 intent, CHỈ qua LiteLLM gateway.
# Key lấy từ ~/.insighthub/gateway.env (CHATOPS_LITELLM_KEY), không dùng provider key trực tiếp.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
CHATOPS_LITELLM_KEY=
CHATOPS_LLM_MODEL=chatops-agent
